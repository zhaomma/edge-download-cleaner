{
  "manifest_version": 3,
  "name": "下载记录定时清理器",
  "version": "1.1.0",
  "description": "点击启动后按设定秒数循环倒计时，到点自动清除浏览器下载记录（不删除磁盘上的下载文件）。循环在后台运行，无需保持弹窗打开。",
  "permissions": ["downloads", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "下载记录定时清理器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
